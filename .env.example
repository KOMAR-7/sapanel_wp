# RESTROCONNECT SuperAdmin Control Plane Environment Configuration (Template)
NODE_ENV=development
PORT=3005
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Control Plane Database (Render PostgreSQL in production / development)
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"
CONTROL_PLANE_DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# Platform SuperAdmin Credentials for Initial Setup
SUPERADMIN_NAME="Platform SuperAdmin"
SUPERADMIN_EMAIL="admin@restroconnect.com"
SUPERADMIN_PASSWORD="ChangeMeInProduction123!"
AUTH_SECRET="your_random_32_character_super_secure_jwt_secret_key"

# Initial Tenant #1 Configuration (Secure Environment Variable Reference)
FIRST_TENANT_DATABASE_URL="postgresql://tenant_user:tenant_pass@host:5432/tenant_db?sslmode=require"
FIRST_TENANT_FRONTEND_URL="https://wp-admin-five.vercel.app/"
FIRST_TENANT_BACKEND_URL=""

# Cache & Redis (Optional local fallback: In-Memory, Production: AWS ElastiCache)
# REDIS_URL=redis://localhost:6379

# AWS Infrastructure Configuration (Foundation Prepared - Step 6)
# Region: ap-south-1 (Mumbai)
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=

# Local Development Credentials (Optional fallback only)
# IMPORTANT: Never commit actual AWS keys. In AWS production/ECS, leave these empty.
# The application automatically uses the IAM Task Role / SDK Default Credential Chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

